{
  "info": {
    "_postman_id": "ipl-auction-collection-v2",
    "name": "IPL Auction Software - Automated API Suite (Week 2)",
    "description": "Postman Automated API Test Suite maintained by Member 5 (QA & API Documentation Lead).\nIncludes Week 2 Edge-Case Testing Scripts for Purse Overflow, Illegal Bids, and Unauthorized API Calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System & Documentation Health",
      "item": [
        {
          "name": "Fetch OpenAPI Specs (/v3/api-docs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is under 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('OpenAPI Title is correct', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.info.title).to.eql('IPL Auction Software API Documentation');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Edge Case API Test Suite (Week 2)",
      "item": [
        {
          "name": "Purse Overflow Attempt (Expect 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": 1,\n  \"playerId\": 101,\n  \"bidAmount\": 999999999999.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bids"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should return 400 Bad Request for Purse Overflow', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Illegal Bid Below Base Price (Expect 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": 1,\n  \"playerId\": 101,\n  \"bidAmount\": -100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bids"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should reject negative or invalid bid amount', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unauthorized API Call Attempt (Expect 401 Unauthorized)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/teams/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "teams",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated request returns 401 or 403', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
