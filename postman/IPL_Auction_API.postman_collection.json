						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains success message', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include('registered');",
