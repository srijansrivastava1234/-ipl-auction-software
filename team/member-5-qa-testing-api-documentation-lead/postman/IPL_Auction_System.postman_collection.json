{
  "info": {
    "_postman_id": "ipl-auction-system-collection-v1",
    "name": "🏏 IPL Mega Auction System - Full Test Suite",
    "description": "Comprehensive Postman test collection for IPL Auction System created by Member 5 (QA & API Documentation Lead). Includes Auth, Teams, Players, and Live Bidding test scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as CSK Team Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns valid JWT token', function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.environment.set('jwt_token', jsonData.token);",
                  "    pm.environment.set('csk_team_id', jsonData.teamId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"csk_owner\",\n  \"password\": \"csk123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login as Admin (Auctioneer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns admin token', function () {",
                  "    pm.expect(jsonData.role).to.eql('ADMIN');",
                  "    pm.environment.set('admin_jwt_token', jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
        },
        {
          "name": "Register New Franchise Team",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns new franchise token and team ID', function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.teamId).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamName\": \"Ahmedabad Aces\",\n  \"username\": \"aces_owner\",\n  \"password\": \"aces123\",\n  \"budget\": 1000000000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-team",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register-team"]
            }
          }
        }
      ]
