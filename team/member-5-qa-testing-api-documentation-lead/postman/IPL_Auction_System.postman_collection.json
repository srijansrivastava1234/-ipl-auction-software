          "name": "Create New Player (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Player created with status 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns created player details', function () {",
                  "    pm.expect(jsonData.name).to.eql('Heinrich Klaasen');",
                  "    pm.expect(jsonData.status).to.eql('UNSOLD');",
